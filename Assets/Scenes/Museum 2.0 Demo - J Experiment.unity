  m_Script: {fileID: -1574112991, guid: 2697c106e3f9e864097cb87b72598f6c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _author: Katsushika Hokusai
  _price: 0
  _year: 1831
  _type: painting
  _description: "La Grande Onda di Kanagawa (1831), capolavoro di Katsushika Hokusai,
    \xE8 la xilografia pi\xF9 celebre della serie Trentasei vedute del Monte Fuji.
    Raffigura un\u2019enorme onda in procinto di travolgere barche, con il Monte
    Fuji sullo sfondo. L\u2019opera combina tradizione giapponese e influenze occidentali,
    come la prospettiva. Simbolo della forza della natura e della fragilit\xE0 umana,
    \xE8 diventata un\u2019icona dell\u2019arte mondiale."
