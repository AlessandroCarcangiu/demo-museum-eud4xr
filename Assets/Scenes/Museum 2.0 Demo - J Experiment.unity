  m_text: "<size=40><color=#fff>Colazione sull'erba</size>\n<size=32><color=#c2c2c3>Realizzata
    da <color=#548AF7>\xC9douard Manet</color> nel 1863, quest'opera segna una svolta
    nell'arte francese, passando dal <color=#548AF7>Realismo all'Impressionismo</color>.</size>\n\n<size=40><color=#fff>Un'opera
    rivoluzionaria</size>\n<size=32><color=#c2c2c3>Rifiutata dal <color=#548AF7>Salon
    ufficiale</color>, esposta al Salon des Refus\xE9s, l'opera rompe le convenzioni
    accademiche con luci, ombre e prospettiva non convenzionale. Esposta al <color=#548AF7>Mus\xE9e
    d'Orsay</color>, ha influenzato profondamente l'arte moderna.</size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
