  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=40><color=#fff>Ragazza col turbante</size>\n<size=32><color=#c2c2c3>Realizzata
    da <color=#548AF7>Johannes Vermeer</color> intorno al 1665, questa opera del
    Barocco olandese \xE8 famosa per la sua maestria nel catturare luce e dettagli.</size>\n\n<size=40><color=#fff>Un'icona
    del Barocco</size>\n<size=32><color=#c2c2c3>Conservata al <color=#548AF7>Mauritshuis
    dell'Aia</color>, \"Ragazza col turbante\" \xE8 soprannominata la \"Monna Lisa
    del Nord\", simbolo della bellezza e della maestria del XVII secolo olandese.</size>"
  m_isRightToLeft: 0
