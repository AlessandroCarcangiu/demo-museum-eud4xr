  m_Script: {fileID: -1574112991, guid: 2697c106e3f9e864097cb87b72598f6c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _author: Hugo Hagen
  _price: 500000
  _year: 1859
  _type: sculpture, bust
  _description: "Il Busto di Beethoven realizzato da Hugo Hagen nel XIX secolo \xE8
    un omaggio alla grandezza del compositore tedesco Ludwig van Beethoven. Raffigurato
    con tratti decisi e un\u2019espressione intensa, il busto trasmette la forza
    e il genio creativo di Beethoven. Hagen, con la sua abilit\xE0 scultorea, celebra
    l'immortalit\xE0 dell'artista, enfatizzandone il carattere imponente e l'eredit\xE0
    musicale senza tempo."
