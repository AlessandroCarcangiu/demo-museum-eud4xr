  m_Script: {fileID: -1574112991, guid: 2697c106e3f9e864097cb87b72598f6c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _author: Sandro Botticelli
  _price: 0
  _year: 1480
  _type: painting
  _description: "Primavera (1480) di Sandro Botticelli \xE8 un capolavoro rinascimentale
    che celebra la bellezza e la mitologia classica. Il dipinto rappresenta la dea
    Venere al centro, circondata da figure allegoriche come le Tre Grazie e Mercurio.
    Con una composizione armoniosa e colori delicati, l'opera simboleggia la fertilit\xE0,
    l'amore e il rinnovamento, riflettendo l'ideale di bellezza e ordine tipico dell'umanesimo
    fiorentino."
