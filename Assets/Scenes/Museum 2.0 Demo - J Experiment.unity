  m_Script: {fileID: -1574112991, guid: 2697c106e3f9e864097cb87b72598f6c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _author: Thutmose
  _price: 123456800
  _year: -1345
  _type: sculpture, bust
  _description: "Il Busto di Nefertiti, attribuito a Thutmose, \xE8 un capolavoro
    dell'arte egizia risalente al 1345 a.C., oggi conservato nel Neues Museum di
    Berlino. Raffigura la regina Nefertiti con straordinaria eleganza e simmetria,
    caratterizzata dal suo iconico copricapo blu. Celebre per la perfezione dei dettagli
    e la vivida policromia, il busto incarna la bellezza ideale e il prestigio dell'epoca
    amarniana."
