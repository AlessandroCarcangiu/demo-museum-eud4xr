      m_Calls: []
  m_text: "<size=40><color=#fff>La persistenza della memoria</size>\n<size=32><color=#c2c2c3>Realizzata
    da <color=#548AF7>Salvador Dal\xED</color> nel 1931, quest'opera \xE8 uno dei
    capolavori del Surrealismo, esplorando il confine tra sogno e realt\xE0.</size>\n\n<size=40><color=#fff>Un'icona
    del Surrealismo</size>\n<size=32><color=#c2c2c3>Al centro, un volto deformato
    suggerisce un'immersione nell'inconscio. Esposta al <color=#548AF7>MoMA</color>,
    l'opera incarna l'essenza del Surrealismo, trasformando l'ordinario in straordinario.</size>"
  m_isRightToLeft: 0
