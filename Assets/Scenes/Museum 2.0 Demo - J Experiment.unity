  m_Script: {fileID: -1574112991, guid: 2697c106e3f9e864097cb87b72598f6c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _author: John Everett Millais
  _price: 0
  _year: 1851
  _type: painting
  _description: "Ofelia (1851-1852) di John Everett Millais \xE8 un\u2019opera emblematicamente
    romantica che raffigura la tragica morte di Ofelia, il personaggio di Amleto
    di Shakespeare. La giovane, immersa in un fiume, sembra fluttuare serenamente
    tra fiori e natura, mentre la sua morte imminente \xE8 resa con grande realismo.
    Millais cattura con maestria l\u2019emotivit\xE0 e la bellezza tragica del momento,
    simbolizzando la fragilit\xE0 della vita umana."
