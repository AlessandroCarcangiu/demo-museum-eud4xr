  m_Script: {fileID: -1574112991, guid: 2697c106e3f9e864097cb87b72598f6c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _author: Rembrandt van Rijn
  _price: 0
  _year: 1642
  _type: painting
  _description: "Rembrandt van Rijn (1606-1669) \xE8 uno dei pi\xF9 grandi pittori
    e incisori olandesi del Seicento. Famoso per la sua abilit\xE0 nel chiaroscuro
    e la profondit\xE0 psicologica dei suoi ritratti, ha saputo catturare l'animo
    umano con straordinaria intensit\xE0. Le sue opere, come La ronda di notte e
    Autoritratto, esplorano temi di luce, ombra e impermanenza, rendendolo una figura
    centrale nella storia dell'arte europea."
