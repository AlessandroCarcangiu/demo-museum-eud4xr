  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<size=40><color=#fff>La Grande Onda di Kanagawa</size>\n<size=32><color=#c2c2c3>Realizzata
    da <color=#548AF7>Katsushika Hokusai nel 1831</color>, quest'opera iconica fa
    parte della serie \"Trentasei vedute del Monte Fuji\".</size>\n\n<size=40><color=#fff>Un
    simbolo senza tempo</size>\n<size=32><color=#c2c2c3>Raffigura un'enorme onda
    in procinto di travolgere barche, con il Monte Fuji sereno sullo sfondo. La scena
    combina dinamismo e equilibrio, rappresentando il <color=#548AF7>contrasto tra
    la forza della natura e la stabilit\xE0</color>.</size>\n\n<size=40><color=#fff>L\u2019onda
    e il Monte Fuji</size>\n<size=32><color=#c2c2c3>Celebrata per la sua bellezza
    e influenza sull'arte occidentale, <color=#548AF7>\xE8 un simbolo universale</color>
    dell'arte globale.</size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
