--- !u!114 &211894495
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 211894493}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0e5ff958b5e044f489b3c3093aad60fa, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _content: "<size=40><color=#fff>Ophelia</size>\n<size=32><color=#c2c2c3>Realizzata
    da <color=#548AF7>John Everett Millais</color> tra il 1851 e il 1852, questa
    opera \xE8 un capolavoro del Preraffaellitismo, che celebra la purezza dei dettagli
    medievali e rinascimentali.</size>\n\n<size=40><color=#fff>Un capolavoro preraffaellita</size>\n<size=32><color=#c2c2c3>Esibita
    alla <color=#548AF7>Tate Britain</color>, \"Ophelia\" \xE8 nota per la sua maestria
    tecnica e il contrasto tra la bellezza della natura e la tragedia imminente,
    lasciando un impatto emotivo duraturo.</size>"
