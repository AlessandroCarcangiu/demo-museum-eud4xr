--- !u!114 &986191721
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 986191719}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0e5ff958b5e044f489b3c3093aad60fa, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _content: "<size=40><color=#fff>La Ronda di Notte</size>\n<size=32><color=#c2c2c3>Realizzata
    da <color=#548AF7>Rembrandt van Rijn nel 1642</color>, quest'opera \xE8 un capolavoro
    del Barocco olandese, rappresentante una compagnia di miliziani in movimento,
    guidata da <color=#548AF7>Frans Banning Cocq</color> e <color=#548AF7>Willem
    van Ruytenburch</color>.</size>\n\n<size=40><color=#fff>Un capolavoro senza tempo</size>\n<size=32><color=#c2c2c3>Esposta
    al <color=#548AF7>Rijksmuseum di Amsterdam</color>,l'opera  \xE8 celebrata per
    la sua composizione dinamica e la maestria nel catturare luce, spazio e l'animo
    umano, testimoniando il genio di Rembrandt.</size>"
