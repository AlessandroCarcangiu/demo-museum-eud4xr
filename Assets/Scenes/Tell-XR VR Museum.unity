--- !u!114 &258326821
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 258326812}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0e5ff958b5e044f489b3c3093aad60fa, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _content: "<size=40><color=#fff>La Zattera della Medusa</size>  \r\n<size=32><color=#c2c2c3>Realizzata
    da <color=#548AF7>Th\xE9odore G\xE9ricault tra il 1818 e il 1819</color>, quest'opera
    \xE8 un capolavoro del Romanticismo francese e si ispira a un tragico evento
    reale: il naufragio della fregata francese Medusa nel 1816.</size>  \r\n\r\n<size=40><color=#fff>Contrasto
    e potenza emotiva</size>  \r\n<size=32><color=#c2c2c3>Il contrasto tra <color=#548AF7>vita
    e morte</color>, speranza e disperazione, \xE8 reso attraverso un drammatico
    uso della luce e dei colori cupi. L'opera \xE8 conservata al <color=#548AF7>Museo
    del Louvre di Parigi</color>.</size>  \r"
