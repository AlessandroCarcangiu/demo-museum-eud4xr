--- !u!114 &842963114
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 842963112}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\"Ragazza col turbante\", conosciuto anche come \"La ragazza con l'orecchino
    di perla\", \xE8 un capolavoro del pittore olandese Johannes Vermeer, realizzato
    intorno al 1665. Questo dipinto a olio appartiene al movimento del Barocco olandese,
    caratterizzato da una profonda attenzione ai dettagli e alla resa della luce.\r\n\r\nL'opera
    ritrae una giovane donna vestita in modo esotico, con un ampio turbante azzurro
    e giallo, e un orecchino di perla che cattura la luce, brillando al centro della
    composizione. L'espressione della ragazza \xE8 enigmatica: le labbra leggermente
    dischiuse e lo sguardo rivolto verso lo spettatore sembrano invitare a una connessione
    intima e misteriosa.\r\n\r\nLa \"Ragazza col turbante\" \xE8 conservata al Mauritshuis
    dell'Aia, nei Paesi Bassi, e viene spesso chiamata la \"Monna Lisa del Nord\"
    per l'aura di fascino e mistero che emana. La sua importanza risiede non solo
    nella straordinaria maestria tecnica di Vermeer, ma anche nella capacit\xE0 di
    evocare emozioni sottili e sfuggenti con una semplicit\xE0 apparente."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
