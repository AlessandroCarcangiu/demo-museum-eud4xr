--- !u!114 &1726613978
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1726613976}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\"Ophelia\", dipinto da John Everett Millais tra il 1851 e il 1852, \xE8
    uno dei capolavori del Preraffaellitismo, movimento artistico inglese che cercava
    di tornare alla purezza e alla ricchezza di dettagli dell'arte medievale e rinascimentale,
    prima di Raffaello. \n\nL'opera ritrae la tragica morte di Ofelia, personaggio
    dell'Amleto di Shakespeare, mentre galleggia nelle acque di un fiume, ormai travolta
    dalla follia, circondata da fiori.  Millais dipinse il paesaggio naturale con
    una precisione quasi scientifica, lavorando per mesi all'aperto sulle rive del
    fiume Hogsmill, vicino a Londra. Il viso di Ofelia, raffigurato con estrema delicatezza,
    \xE8 basato sulle fattezze di Elizabeth Siddal, una delle muse pi\xF9 celebri
    dei preraffaelliti.  \n\n\"Ophelia\" \xE8 conservato alla Tate Britain di Londra.
    La sua importanza risiede non solo nella maestria tecnica di Millais, ma anche
    nella capacit\xE0 di evocare una potente atmosfera malinconica e poetica, resa
    con un'incredibile attenzione ai dettagli naturalistici. Il contrasto tra la
    bellezza della natura e la tragedia imminente della morte di Ofelia crea un impatto
    visivo ed emotivo indimenticabile."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
