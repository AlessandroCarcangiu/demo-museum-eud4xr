  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\"La Zattera della Medusa\", dipinto da Th\xE9odore G\xE9ricault nel 1818-1819,
    \xE8 un'opera chiave del Romanticismo francese. Il quadro si ispira a un tragico
    evento reale: il naufragio della fregata francese Medusa al largo della costa
    africana nel 1816, in cui solo 15 dei 147 passeggeri sopravvissero dopo essere
    stati abbandonati su una zattera alla deriva per giorni. \n\n La composizione
    \xE8 dominata dal caos e dalla disperazione dei naufraghi, alcuni ormai morti,
    altri aggrappati alla speranza di salvezza, con uno di loro che, dall'alto della
    zattera, sventola uno straccio per cercare di attirare l'attenzione di una nave
    all'orizzonte. Il contrasto tra la morte e la vita, la speranza e la disperazione,
    \xE8 reso con grande potenza emotiva, attraverso un uso drammatico della luce
    e dei colori cupi.  \"La Zattera della Medusa\" \xE8 conservata al Museo del
    Louvre di Parigi. \n\nL'importanza dell'opera risiede non solo nella sua straordinaria
    intensit\xE0 visiva, ma anche nella sua forte critica sociale e politica: il
    naufragio era stato causato dall'incompetenza del governo francese dell'epoca,
    e G\xE9ricault volle denunciare questa ingiustizia. L'opera \xE8 un emblema del
    Romanticismo per la sua rappresentazione delle emozioni estreme e del dramma
    umano."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
