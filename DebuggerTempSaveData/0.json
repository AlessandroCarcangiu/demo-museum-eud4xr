        },
        "isVisible": "no",
        "isActive": "yes",
        "isInsideCamera": "no"
      },
      "ECAText": {
        "content": "<size=40><color=#fff>La Ronda di Notte</size>\n<size=32><color=#c2c2c3>Realizzata da <color=#548AF7>Rembrandt van Rijn nel 1642</color>, quest'opera è un capolavoro del Barocco olandese, rappresentante una compagnia di miliziani in movimento, guidata da <color=#548AF7>Frans Banning Cocq</color> e <color=#548AF7>Willem van Ruytenburch</color>.</size>\n\n<size=40><color=#fff>Un capolavoro senza tempo</size>\n<size=32><color=#c2c2c3>Esposta al <color=#548AF7>Rijksmuseum di Amsterdam</color>,l'opera  è celebrata per la sua composizione dinamica e la maestria nel catturare luce, spazio e l'animo umano, testimoniando il genio di Rembrandt.</size>"
      },
      "ECABehaviour": {},
      "ECAInteractable": {}
    },
    "PannelloDescrizione_LaGrandeOnda": {
