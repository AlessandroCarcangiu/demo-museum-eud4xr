          "z": 0.0008000002
        },
        "isVisible": "off",
        "isActive": "yes",
        "isInsideCamera": "no"
      },
      "ECAText": {
        "content": "<size=40><color=#fff>La Grande Onda di Kanagawa</size>\n<size=32><color=#c2c2c3>Realizzata da <color=#548AF7>Katsushika Hokusai nel 1831</color>, quest'opera iconica fa parte della serie \"Trentasei vedute del Monte Fuji\".</size>\n\n<size=40><color=#fff>Un simbolo senza tempo</size>\n<size=32><color=#c2c2c3>Raffigura un'enorme onda in procinto di travolgere barche, con il Monte Fuji sereno sullo sfondo. La scena combina dinamismo e equilibrio, rappresentando il <color=#548AF7>contrasto tra la forza della natura e la stabilità</color>.</size>\n\n<size=40><color=#fff>L’onda e il Monte Fuji</size>\n<size=32><color=#c2c2c3>Celebrata per la sua bellezza e influenza sull'arte occidentale, <color=#548AF7>è un simbolo universale</color> dell'arte globale.</size>"
      },
